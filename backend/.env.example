# 数据库配置
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=trip_memory

# 应用配置
APP_NAME=TripMemory
APP_VERSION=1.0.0
HOST=0.0.0.0
PORT=8003

# JWT配置
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# TripCanvas对接配置
TRIPCANVAS_API_URL=http://127.0.0.1:8002/api
TRIPCANVAS_API_TOKEN=

# 百度网盘配置（在百度网盘开放平台申请，勿提交真实值）
BAIDUNET_APP_KEY=YOUR_BAIDUNET_APP_KEY
BAIDUNET_SECRET_KEY=YOUR_BAIDUNET_SECRET_KEY
BAIDUNET_REDIRECT_URI=oob

# AI大模型配置
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
