# TripMemory 生产环境配置模板
# 复制到服务器 ~/tripmemory/.env 后，将下方 YYY 占位替换为真实密钥再使用。
# 严禁提交真实密钥到 Git 仓库。

# 数据库（复用服务器的 news-mysql 容器）
DB_HOST=news-mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=YOUR_DB_PASSWORD
DB_NAME=trip_memory

# 服务监听
HOST=0.0.0.0
PORT=8003

# TripCanvas 对接（同一台服务器，容器网络内直连）
TRIPCANVAS_API_URL=http://trip-backend:8002/api
# 静态 token 可留空，使用下方服务账号自动登录续期
TRIPCANVAS_API_TOKEN=
TRIPCANVAS_SERVICE_USERNAME=YOUR_TRIPCANVAS_SERVICE_USER
TRIPCANVAS_SERVICE_PASSWORD=YOUR_TRIPCANVAS_SERVICE_PASS

# 百度网盘 OAuth（在百度网盘开放平台申请）
BAIDUNET_APP_KEY=YOUR_BAIDUNET_APP_KEY
BAIDUNET_SECRET_KEY=YOUR_BAIDUNET_SECRET_KEY
BAIDUNET_REDIRECT_URI=http://YOUR_SERVER_IP:8082/baidu-sync

# DeepSeek LLM
LLM_API_KEY=YOUR_DEEPSEEK_API_KEY
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# JWT 签名密钥（生产环境请改为随机字符串）
JWT_SECRET=YOUR_RANDOM_JWT_SECRET
